elementor-section-height-default\" data-id=\"69477d1\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-c52aada\" data-id=\"c52aada\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-e6128f6 fc-game-genre elementor-widget elementor-widget-heading\" data-id=\"e6128f6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-heading-title elementor-size-default\">Action</div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-cfe39c7 fc-game-genre elementor-widget elementor-widget-heading\" data-id=\"cfe39c7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-heading-title elementor-size-default\">Adventure </div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-97d8b37 fc-game-genre elementor-widget elementor-widget-heading\" data-id=\"97d8b37\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-heading-title elementor-size-default\">RPG </div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6a45711 fc-game-genre elementor-widget elementor-widget-heading\" data-id=\"6a45711\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-heading-title elementor-size-default\">Arcade Platformer</div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<div class=\"elementor-element elementor-element-89bf92d fc-game-description elementor-widget elementor-widget-text-editor\" data-id=\"89bf92d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><!--ScriptorStartFragment--></p><div class=\"scriptor-paragraph\">A young Viking warrior has lost everything to the forces of evil. Driven by revenge and the search for answers, Saga embarks on a dangerous journey across a land plagued by relentless enemies and fearsome bosses.</div><div class=\"scriptor-paragraph\">Inspired by the golden age of 80s and 90s gaming, Saga delivers a classic 2D action-platforming experience with beautiful pixel art, authentic retro visuals, and an unforgettable soundtrack. Every level presents new challenges, powerful enemies, and epic encounters that will test your skills and determination.</div><div class=\"scriptor-paragraph\">Will you help Saga uncover the truth and bring peace back to her homeland?<!--ScriptorEndFragment--></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-3426b50 elementor-section-full_width fc-game-features-media elementor-section-height-default\" data-id=\"3426b50\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-52 elementor-top-column elementor-element elementor-element-1bfa653\" data-id=\"1bfa653\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6db1fc8 fc-game-features-heading elementor-widget elementor-widget-heading\" data-id=\"6db1fc8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Features:</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0bb0487 fc-game-features elementor-widget elementor-widget-text-editor\" data-id=\"0bb0487\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><!--ScriptorStartFragment--></p><ul><li class=\"scriptor-listItemlist!list-Solo0\">Classic 2D action-platformer gameplay inspired by retro console adventures.</li><li class=\"scriptor-listItemlist!list-Solo0\">A compelling story that keeps players engaged from beginning to end.</li><li class=\"scriptor-listItemlist!list-Solo0\">10 handcrafted levels connected through a world map with multiple paths to choose from.</li><li class=\"scriptor-listItemlist!list-Solo0\">11 unique boss battles, each with their own mechanics and challenges.</li><li class=\"scriptor-listItemlist!list-Solo0\">A wide variety of enemies to fight throughout the adventure.</li><li class=\"scriptor-listItemlist!list-Solo0\">Fast-paced combat and exploration.</li><li class=\"scriptor-listItemlist!list-Solo0\">Retro-inspired soundtrack with 10 original tracks, one for each level.</li><li class=\"scriptor-listItemlist!list-Solo0\">Pixel-perfect graphics with a 16-color palette.</li><li class=\"scriptor-listItemlist!list-Solo0\">CRT filter and authentic old-school presentation.</li><li class=\"scriptor-listItemlist!list-Solo0\">Designed to recreate the feeling of classic Mega Drive and Master System games.</li></ul><p><!--ScriptorEndFragment--></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t<div class=\"elementor-column elementor-col-48 elemento