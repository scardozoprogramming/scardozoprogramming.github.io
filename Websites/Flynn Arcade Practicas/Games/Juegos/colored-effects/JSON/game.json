  "blocks": [
    {
      "type": "paragraph",
      "text": "Colored Effects is a puzzle platformer game where you use different abilities to advance through levels. Each color grants a unique ability. Switch between the colors and their effects to collect gems, defeat bosses, and solve fun puzzles."
    },
    {
      "type": "heading",
      "text": "Colors and Effects"
    },
    {
      "type": "paragraph",
      "text": "Effects are the abilities you use in the game, each effect is unique and distinguishable by its own color. Switching Colors at the right moment is the key to progress."
    },
    {
      "type": "heading",
      "text": "Unique Bosses"
    },
    {
      "type": "paragraph",
      "text": "Encounter bosses in between levels, each boss has unique attacks and requires a different way to defeat it."
    },
    {
      "type": "heading",
      "text": "Restart and try again"
    },
    {
      "type": "paragraph",
      "text": "You may die or get trapped in this game, nothing prevents you from restarting at any moment and getting back in an instant."
    }
  ],
